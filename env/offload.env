# NUMA-local KV CPU offload of the 8x RTX PRO 6000 (AS-5126GS-TNRT2) box (S1-10): vLLM `--numa-bind` + SimpleCPUOffloadConnector with an
# exact per-rank tier. Sourced AFTER env/host.env; for speculative launches env/spec_k7.env sources it itself (S1-10R adoption), before it reads the
# MUSE_SPEC_KV_BYTES_OVERRIDE that this file sets, so the exact GPU KV bytes, the tier and the flags are ONE launch property
# (scripts/check_offload_launch.sh checks the pairing from the boot log and serve_cmd.txt).
#
#   source $HOST_DIR/env/host.env; source $HOST_DIR/env/spec_k7.env      # speculative profile (spec_k7.env sources this file; the gate's explicit host.env, offload.env, spec_k7.env order is the same)
#   SERVE_EXTRA="$MUSE_SPEC_SERVE_ARGS --kv-cache-memory-bytes $MUSE_SPEC_KV_BYTES $MUSE_OFFLOAD_SERVE_ARGS" SPEC_CONFIG=dflash2_radixark ... serve_sd.sh <tag> ...
#   source $HOST_DIR/env/host.env; MUSE_OFFLOAD_PROFILE=ns256 source $HOST_DIR/env/offload.env                              # non-speculative mns 256
#   vllm serve ... --max-num-seqs 256 --max-cudagraph-capture-size 256 --kv-cache-memory-bytes $MUSE_OFFLOAD_KV_BYTES $MUSE_OFFLOAD_SERVE_ARGS
#
# What the launch property is (details and measurements: docs/s110_numa_offload.md):
#   * `--numa-bind`: every worker runs under `numactl --cpunodebind=N --membind=N` (N = its GPU's node: GPU 0,1 -> 3, 2,3 -> 0, 4,5 -> 7, 6,7 -> 4), so the
#     pinned tier of a rank is 100 % on its GPU's node; without it 15-33 % of a tier lands on other nodes (and spills onto the GPU-less nodes 1, 2, 5, 6).
#     No decode cost (OFF gmean 0.995..1.005 of the no-bind launch), no TTFT difference on the reuse workload.
#   * SimpleCPUOffloadConnector (kv_role kv_both, eager): per-rank private tensors, first-touched and cudaHostRegister'ed by the owning rank; `cpu_bytes_to_use_per_rank`
#     is exact (blocks = floor(bytes / bytes-per-block-id)); `cpu_bytes_to_use` = 8 x that value keeps the connector's own consistency warning quiet.
#     The native OffloadingConnector was measured and is NOT used (whole-region pinning in every worker: +386 MiB GPU page tables and +120..150 s boot at a 24 GiB tier,
#     decode gmean 0.980..0.988, output of a CPU hit differs from the GPU hit under speculation).
#   * the vLLM branch must carry the S1-10 `receives_remote_kv` fix (a kv_both connector otherwise switches the text-only launch to the multimodal embedding path:
#     128 MiB of GPU memory and a model on input embeddings); check_offload_launch.sh fails a log with "enable_mm_embeds is True".
#
# 0.33.0-DERIVED VALUES (S1-10R phase 3, 2026-11-11; vLLM sm120-muse-spark-open f6a60ab9d7, production host main 942acddc48, fused boundary default 1): the values below replace
# the 0.32.0 numbers of the S1-10 gate (268c64b0e2 + 9388ed1133, host 6f47eb1790; 45 GiB tier, spec 11,525,693,440, ns256 16,957,243,392, ns128 17,357,799,424). Sources:
# muse_wf/s1-10r/phase3_an.json (A_N, P*) and muse_wf/s1-10r/phase3_stress.json (S1-7 stress with the tier on, S_live); details and the per-boot table: docs/s110_numa_offload.md
# sections 4 and 5. They are inputs of the S1-10R phase 4 gate chain (the gate ran on the file with md5 8d70d4dfa60d98c47fcfe7d4238852a6 recorded in ADOPTION_RULE_FINAL_AMENDMENT3.md5; the S1-10R adoption edited comments only, every non-comment line is identical to that file).
#   - MUSE_OFFLOAD_PER_RANK_BYTES = P* = 51,814,072,320 B (48.2556 GiB; 2,529,984 spec blocks / 790,620 ns blocks per rank): P* = L * floor((min_N A_N - M) / (2 * L)) with
#     L = 327,680 B, M = 6.6 GiB and A_N = MemFree_N + Active(file)_N + Inactive(file)_N measured on 0.33.0 with the server up (spec profile, tier off, bound, after decode +
#     reuse + chat; 2026-11-11 06:20 server time), MiB: node 3 119,262.8, node 0 118,644.1, node 7 105,586.3 (the limiter), node 4 119,641.2 (S1-10 on 0.32.0: 117,205 /
#     117,738 / 98,892 / 118,063). A_7 rose by 6.5 GiB (6,694 MiB) because the old node 7 carried 6,688 MiB of reclaimable slab that A_N does not count (302 MiB now): P* is only valid for a
#     node-7 slab below ~0.3 GiB, so scripts/preflight_offload.sh must run before every ON boot. M = 6.6 GiB was kept (re-itemised on 0.33.0: 3.5-4.5 GiB of growth and transients).
#   - MUSE_OFFLOAD_BPB (bytes per block-id) = 20,480 (spec) / 65,536 (ns), UNCHANGED on 0.33.0 (logged: bytes per block-id from the boot summary and per_rank_bytes / blocks, every ON boot;
#     the DFlash draft slots 7 -> 0 change did not move them); tier blocks per rank as logged: "Allocating 2529984 offload blocks (48.26 GB)" and eight "5 tensors, 2529984 CPU blocks"
#     (spec), 790620 and "16 tensors, 790620 CPU blocks" (ns). 327,680 B is still the lcm of the two (P* = 158,124 L).
#   - MUSE_OFFLOAD_KV_BYTES of the three profiles (S1-7 stress with the tier on at P*, floors spec 1,256 MiB / ns 500 MiB; the tier costs 2 MiB of GPU page tables per GiB, 96.5 MiB):
#     spec 11,645,337,600 (-74,874,880 B = -3,656 blocks against the no-tier 0.33.0 bytes 11,720,212,480, S1-13), ns256 16,854,810,624 (-102,432,768 B against 16,957,243,392),
#     ns128 17,257,267,200 (-100,532,224 B against 17,357,799,424). See the Offload-on GPU bytes comment below for blocks, tokens and S_live.
# The design (file layout, re-source rule, serve arguments, the spec_k7.env override hand-over) is unchanged from the gated state. S1-10R ADOPTION (2026-11-12, ADOPT_SPEC=yes under POST-HOC
# amendment 5): spec_k7.env now sources this file itself for the speculative profile (MUSE_OFFLOAD_PROFILE=spec for that source, MUSE_OFFLOAD defaults to 1, MUSE_OFFLOAD=0 opts out); sourcing
# it explicitly before spec_k7.env (the gate's order) still gives identical exports. Non-speculative launches (ns256 RECOMMENDED, ns128 shipped) source this file with their profile as before.
# KNOWN OPEN POINT of the phase 3 boots at P*: 7 of the 9 valid ON boots swapped out 3.7-5.5 GiB of unpinned worker / EngineCore / API-server anonymous memory (cause open: the gap to
# the previous teardown does not separate the swapping from the non-swapping boots; node pressure at P* is the other candidate; a smaller P* is an unmeasured hypothesis); no OOM kill, no errors.
# No criterion of ADOPTION_RULE_FINAL (G1-G5, D) or amendments 1-3 covers swap; the keep-or-reduce decision for P* is made by AMENDMENT4 (POST-HOC, written before the first 0.33.0 gate boot).
# Phase 3 itself had all_pass=false: the pre-stated no-swap criterion failed in the 3 confirming boots.
#
# MUSE_OFFLOAD=0 gives the launch without offload (no binding, no connector, the S1-9 bytes; env/spec_k7.env then keeps its own bytes).
#
# THE TIER SURVIVES `POST /reset_prefix_cache` (S1-10 gate review): that endpoint empties the GPU pool only. With the tier on, every benchmark that re-sends a
# prompt after such a reset (bench_sd.sh rows, acceptance passes, repeated fixed-seed prompts across cells / repetitions) HITS THE TIER and reads as a speed-up
# (the first unsalted decode sweep of S1-10 read 2,142 tok/s at c128 against 1,340 without the tier: reuse, not overhead). Rows that must not reuse need a
# `cache_salt` per request (the S1-9 L7 driver --cycle does that) or `POST /reset_prefix_cache?reset_external=true` (resets the connector tier too; a no-op without
# a connector). The sd harness (bench_sd.sh, acceptance.py) sends reset_external=true since S1-10; offline: `llm.reset_prefix_cache(reset_connector=True)`.
#
# One re-source rule: this file derives everything (profile bytes, block size, serve arguments, the speculative override) from MUSE_OFFLOAD, MUSE_OFFLOAD_NUMA_BIND,
# MUSE_OFFLOAD_PROFILE and MUSE_OFFLOAD_PER_RANK_BYTES on EVERY source, so sourcing it twice in one shell (ns256, then spec) never carries state over. The only operator
# override of the offload-on GPU bytes is MUSE_OFFLOAD_KV_BYTES_OVERRIDE (e.g. the bytes of another capture list: it must come from the S1-7 procedure); a
# MUSE_SPEC_KV_BYTES_OVERRIDE preset by hand is discarded with a note while the tier is on (the bytes of an offload-on launch are an offload property).
# An unknown profile returns 1 with MUSE_OFFLOAD=0 and MUSE_OFFLOAD_ERROR set (scripts/check_offload_launch.sh fails on it).
# Offload-on GPU bytes, 0.33.0-derived (S1-7 procedure with the tier, P* = 48.26 GiB per rank: page tables 2 MiB per GiB = 96.5 MiB; the GPU KV allocation is quantized to 2 MiB):
#   spec  11,645,337,600 = 568,620 blocks = 1,639,394 KV tokens per rank, S_live 1,256.6 MiB (floor 1,256; start 11,720,212,480 gave 1,184.6, step down by the 71.4 MiB shortfall);
#   ns256 16,854,810,624 = 257,184 blocks = 2,893,281 tokens, S_live 501.8 (floor 500; 16,957,243,392 gave 403.8; 16,856,317,952 and 16,856,055,808 gave 499.8, below the floor);
#   ns128 17,257,267,200 = 263,325 blocks = 2,962,366 tokens, S_live 501.1 (floor 500; 17,357,799,424 gave 405.1; 17,258,250,240 gave 499.1).
# All three: confirmed boots with 0 errors / preemptions / OOM / tracebacks, health 200 (s1-10r/phase3_stress.json). Previous 0.32.0 values (45 GiB tier): spec 11,525,693,440,
# ns256 16,957,243,392, ns128 17,357,799,424.
: "${MUSE_OFFLOAD:=1}"
: "${MUSE_OFFLOAD_NUMA_BIND:=1}"
# spec = RadixArk DFlash2 K = 7 line of env/spec_k7.env, ns128 / ns256 = the non-speculative launches (host.env only)
: "${MUSE_OFFLOAD_PROFILE:=spec}"
# Per-rank tier bytes (pinned host memory of each GPU's node, 2 ranks per node). A multiple of 327,680 B (= lcm of the bytes per block-id of both
# profiles), so the same value gives an exact block count in every profile. Sizing formula and the numbers behind it: docs/s110_numa_offload.md.
# scripts/preflight_offload.sh checks the free memory of the four nodes against it before a launch.
# 0.33.0-derived P* = 51,814,072,320 B (48.2556 GiB = 158,124 x 327,680; node 7 binds it, see the 0.33.0-DERIVED VALUES block above); the 0.32.0 value was 48,318,382,080 (45 GiB).
: "${MUSE_OFFLOAD_PER_RANK_BYTES:=51814072320}"
# derived state is rebuilt on every source: our own previous export of the speculative override is dropped (a value that differs from it was set by the operator)
if [ -n "${MUSE_SPEC_KV_BYTES_OVERRIDE:-}" ] && [ "$MUSE_SPEC_KV_BYTES_OVERRIDE" = "${_MUSE_OFFLOAD_SPEC_OVERRIDE_SET:-}" ]; then
  unset MUSE_SPEC_KV_BYTES_OVERRIDE
fi
unset _MUSE_OFFLOAD_SPEC_OVERRIDE_SET MUSE_OFFLOAD_KV_BYTES MUSE_OFFLOAD_BPB MUSE_OFFLOAD_SERVE_ARGS MUSE_OFFLOAD_ERROR
case "$MUSE_OFFLOAD_PROFILE" in
  # BPB and KV bytes of every profile: 0.33.0-derived (S1-10R phase 3)
  spec)  MUSE_OFFLOAD_BPB=20480;  MUSE_OFFLOAD_KV_BYTES=11645337600 ;;   # 0.33.0, tier on: S_live 1,256.6 MiB (floor 1,256); no-tier flag-2 bytes 11,720,212,480; 0.32.0: 11,525,693,440
  ns128) MUSE_OFFLOAD_BPB=65536;  MUSE_OFFLOAD_KV_BYTES=17257267200 ;;   # 0.33.0, tier on: S_live 501.1 MiB (floor 500); no-tier 17,357,799,424
  ns256) MUSE_OFFLOAD_BPB=65536;  MUSE_OFFLOAD_KV_BYTES=16854810624 ;;   # 0.33.0, tier on: S_live 501.8 MiB (floor 500); no-tier 16,957,243,392
  *)
    MUSE_OFFLOAD_ERROR="unknown MUSE_OFFLOAD_PROFILE=$MUSE_OFFLOAD_PROFILE (spec | ns128 | ns256)"
    echo "env/offload.env: $MUSE_OFFLOAD_ERROR: no offload in this launch" >&2
    MUSE_OFFLOAD=0
    MUSE_OFFLOAD_SERVE_ARGS=""
    export MUSE_OFFLOAD MUSE_OFFLOAD_PROFILE MUSE_OFFLOAD_ERROR MUSE_OFFLOAD_SERVE_ARGS
    return 1 2>/dev/null || exit 1
    ;;
esac
if [ -n "${MUSE_OFFLOAD_KV_BYTES_OVERRIDE:-}" ]; then
  echo "env/offload.env: NOTE offload-on KV bytes ${MUSE_OFFLOAD_KV_BYTES:-(none derived)} replaced by MUSE_OFFLOAD_KV_BYTES_OVERRIDE=$MUSE_OFFLOAD_KV_BYTES_OVERRIDE (must come from the S1-7 procedure)" >&2
  MUSE_OFFLOAD_KV_BYTES=$MUSE_OFFLOAD_KV_BYTES_OVERRIDE
fi
export MUSE_OFFLOAD MUSE_OFFLOAD_NUMA_BIND MUSE_OFFLOAD_PROFILE MUSE_OFFLOAD_PER_RANK_BYTES MUSE_OFFLOAD_BPB MUSE_OFFLOAD_KV_BYTES
if [ "$MUSE_OFFLOAD" = 1 ]; then
  MUSE_OFFLOAD_SERVE_ARGS=""
  [ "$MUSE_OFFLOAD_NUMA_BIND" = 1 ] && MUSE_OFFLOAD_SERVE_ARGS="--numa-bind "
  MUSE_OFFLOAD_SERVE_ARGS="${MUSE_OFFLOAD_SERVE_ARGS}--kv-transfer-config {\"kv_connector\":\"SimpleCPUOffloadConnector\",\"kv_role\":\"kv_both\",\"kv_connector_extra_config\":{\"cpu_bytes_to_use\":$((MUSE_OFFLOAD_PER_RANK_BYTES * 8)),\"cpu_bytes_to_use_per_rank\":$MUSE_OFFLOAD_PER_RANK_BYTES}}"
  # The exact --kv-cache-memory-bytes of the speculative profile with the tier on: spec_k7.env (sourced next) uses this value instead of its own.
  if [ "$MUSE_OFFLOAD_PROFILE" = spec ]; then
    if [ -n "${MUSE_SPEC_KV_BYTES_OVERRIDE:-}" ]; then
      echo "env/offload.env: NOTE MUSE_SPEC_KV_BYTES_OVERRIDE=$MUSE_SPEC_KV_BYTES_OVERRIDE discarded: the bytes of an offload-on launch are $MUSE_OFFLOAD_KV_BYTES (MUSE_OFFLOAD_KV_BYTES_OVERRIDE changes them, MUSE_OFFLOAD=0 drops the tier)" >&2
    fi
    MUSE_SPEC_KV_BYTES_OVERRIDE=$MUSE_OFFLOAD_KV_BYTES
    _MUSE_OFFLOAD_SPEC_OVERRIDE_SET=$MUSE_OFFLOAD_KV_BYTES
    export MUSE_SPEC_KV_BYTES_OVERRIDE
  fi
else
  MUSE_OFFLOAD_SERVE_ARGS=""
fi
export MUSE_OFFLOAD_SERVE_ARGS
