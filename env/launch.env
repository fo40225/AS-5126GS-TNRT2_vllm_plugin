# Structure and expectations of the production launch scripts (launch/serve_spec.sh, launch/serve_nonspec.sh) and of the post-boot
# check scripts/check_kv_launch.sh (S1-11). Sourced AFTER env/host.env by the launch scripts; it is a plain data file: every value is a
# shell variable with the prefix LAUNCH_ and NOTHING here is exported, so sourcing it adds no variable to the environment of the server
# (the equivalence records env.txt / pid_environ.txt of the gated boots stay byte-equal).
#
# One source of truth: the numbers of the speculative profile live in env/spec_k7.env, the offload-on bytes, the tier size and the
# profile table in env/offload.env. This file adds only what had no home yet: the flags every launch shares, the no-tier bytes of the
# non-speculative profiles (S1-9 L5 B4 on the vLLM 0.33.0 line, 0.33.0 validation boots v033s3_ns256 / v033s3_ns128), and the KV token and
# block counts that the exact bytes produce (the boots of S1-10R adoption, S1-14 and the 0.33.0 validation).

# ---- what every production launch shares (the line of the gated boots, flag for flag)
LAUNCH_MODEL=unsloth/Muse-Spark-Open-816B-A42B-NVFP4
LAUNCH_TP=8
LAUNCH_MAX_MODEL_LEN=131072
LAUNCH_GPU_UTIL=0.95
LAUNCH_HOST=127.0.0.1
LAUNCH_PORT=8100
LAUNCH_KV_DTYPE=fp8
LAUNCH_QUANT=modelopt_fp4
LAUNCH_LIMIT_MM='{"image":0,"audio":0,"video":0}'
# split on whitespace when the line is built
LAUNCH_PARSER_ARGS="--reasoning-parser muse --tool-call-parser muse --enable-auto-tool-choice"

# ---- speculative profile (the sampling parameters and flags beside env/spec_k7.env, which carries the capture size, MNBT, MNST and the bytes)
LAUNCH_SPEC_MNS=128
LAUNCH_SPEC_K=7
LAUNCH_SPEC_METHOD=dflash
LAUNCH_SPEC_DRAFT_SAMPLE=probabilistic
LAUNCH_SPEC_REJECTION=block
LAUNCH_SPEC_DRAFTER=/raid/.cache/huggingface/hub/models--RadixArk--Muse-Spark-Open-DFlash2/snapshots/46c90f412549c472941a68382d91a99e5e6372a0
LAUNCH_SPEC_EXTRA_ARGS="--per-request-spec-decode-metrics detailed"
# the speculative profile is the only one that sets VLLM_SERVER_DEV_MODE (both adoption records carry it)
LAUNCH_SPEC_DEV_MODE=1

# ---- non-speculative profiles: --max-num-seqs, the capture-size flag (empty = no flag: the vLLM default list, FULL decode graphs up to
# --max-num-seqs), the no-tier --kv-cache-memory-bytes, whether the tier is ON when MUSE_OFFLOAD is not given, and the largest FULL decode
# graph the boot logs. The offload-on bytes are in env/offload.env (ns128 17,257,267,200, ns256 16,854,810,624).
# ns256: RECOMMENDED by the S1-10R verdict (tier ON by default). ns128: SHIPPED as a profile on its X stress alone, without an A/B
# (orchestrator decision, S1-11 Amendment 2): tier OFF by default, MUSE_OFFLOAD=1 opts in.
LAUNCH_NS128_MNS=128
LAUNCH_NS128_CAP=
LAUNCH_NS128_KV_BYTES=17357799424      # S1-9 L5 B4; 0.33.0 validation S_live 503.1 MiB (floor 500)
LAUNCH_NS128_OFFLOAD_DEFAULT=0
LAUNCH_NS128_GRAPH_HI=128
LAUNCH_NS256_MNS=256
LAUNCH_NS256_CAP=256
LAUNCH_NS256_KV_BYTES=16957243392      # S1-9 L5 B4 with the capture cap 256; 0.33.0 validation S_live 500.8 MiB (floor 500)
LAUNCH_NS256_OFFLOAD_DEFAULT=1
LAUNCH_NS256_GRAPH_HI=256

# ---- expectations after the boot: "<GPU KV tokens per rank> <num_gpu_blocks>" per profile and tier state (<profile>_<1 = tier ON | 0 = OFF>)
LAUNCH_EXPECT_spec_1="1639394 568620"    # S1-10R adoption boot adopt_spec_on (bytes 11,645,337,600)
LAUNCH_EXPECT_spec_0="1649935 572276"    # S1-13 / adoption boot adopt_spec_off (bytes 11,720,212,480)
LAUNCH_EXPECT_ns256_1="2893281 257184"   # adoption boot adopt_ns256 (bytes 16,854,810,624)
LAUNCH_EXPECT_ns256_0="2910864 258747"   # 0.33.0 validation boot v033s3_ns256_1 (bytes 16,957,243,392)
LAUNCH_EXPECT_ns128_1="2962366 263325"   # adoption boot adopt_ns128 (bytes 17,257,267,200)
LAUNCH_EXPECT_ns128_0="2979623 264859"   # S1-14 production boot pb_ns128 / validation boot v033s3_ns128_1 (bytes 17,357,799,424)

# ---- the machine paths of the runtime (server layout under /raid/vllm-runtime; the host folder is the one the scripts live in)
LAUNCH_DEV=/raid/vllm-runtime/sm120-dev
LAUNCH_TREE=$LAUNCH_DEV/src
LAUNCH_READY_TIMEOUT_S=3600
LAUNCH_ENGINE_READY_TIMEOUT_S=7200     # exported by the launch scripts as VLLM_ENGINE_READY_TIMEOUT_S (the gated boots did)
