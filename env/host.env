# Host environment of the 8x RTX PRO 6000 (AS-5126GS-TNRT2) box. Sourced by scripts/run_src_topo.sh and
# scripts/runsrc_topo.sh. Every value can be overridden by exporting it before the script runs (":=" keeps a preset
# value), e.g. MUSE_TOPO_ENABLE=0 gives the NCCL-only baseline with the same launch path.

# Direct P2P across the CPU sockets: NCCL 2.29.7's graph search fails on this box and routes the 4 cross-pair ring
# hops through host SHM. Same ring/channels/protocol, bitwise identical outputs (2026-10-21). Default ON.
: "${NCCL_P2P_LEVEL:=SYS}"
# muse_topo vLLM plugin (muse_topo/vllm_plugin.py, found through muse_topo-0.1.dist-info on PYTHONPATH): TP all-reduce /
# all-gather over the topology-specialized P2P kernels, class more_accurate (single final rounding of an fp32 sum).
: "${MUSE_TOPO_ENABLE:=1}"
# NCCL 2.30.7 (vllm 0.33 venv): with P2P_LEVEL=SYS (and without it) the graph search still fails, and the cross-socket hops 3>4 / 7>0
# are then connected over the RoCE NIC (NET/IB/5, mlx5_2:2) instead of P2P / SHM (observed with the NIC in RoCE mode; since
# 2026-11-10 it is in IB mode and NCCL_IB_DISABLE=1 stays required). That connection cannot be established
# (ibv_modify_qp: Operation not supported), so the FIRST NCCL collective (vLLM's PyNcclCommunicator warm-up, torch ProcessGroupNCCL,
# nccl-tests) fails with "unhandled system error". NCCL 2.29.7 never used the NIC inside the node. All traffic of a TP8 job stays
# inside the box, so the IB transport is switched off: every hop is then P2P (SYS) and the outputs are bitwise identical to 2.29.7
# (HOST_PLUGIN_V033.md). Needed with NCCL_GRAPH_FILE as well (graph_r4.xml fails with IB on: "Could not find NET with id 0").
: "${NCCL_IB_DISABLE:=1}"
export NCCL_P2P_LEVEL MUSE_TOPO_ENABLE NCCL_IB_DISABLE
# Allowlist of the vLLM plugin entry-point names (vllm/plugins/__init__.py load_plugins_by_group: applied to every plugin group; unset = load
# everything). The vllm 0.33 venv has flashinfer 0.7.2.post1, whose vendored b12x shadows the b12x 1.5.1 wheel, so the wheel's own general
# plugins b12x_fp6 and b12x_loader fail to import in every process (about 20 ERROR tracebacks per boot, "No module named 'b12x.integration'"; vLLM
# carries on, neither plugin is used by this launch path). Only muse_topo is needed here (the lora_*_resolver entry points are off by default).
# Replaced when empty (an empty list matches no plugin and would switch muse_topo off); a value set by the caller wins and must contain muse_topo.
: "${VLLM_PLUGINS:=muse_topo}"
export VLLM_PLUGINS

# ---- opt-ins and knobs (all off / defaults unless uncommented) ---------------------------------------------------
# Route only some ops through the topo path (default: all_reduce,all_gather,reduce_scatter,boundary; `boundary` = the fused
# collective + epilogue kernels of the decode layer, below):
#   export MUSE_TOPO_OPS=all_reduce
# Spin timeout of the kernels in seconds (plugin default 600; the kernel traps when a peer is later than this):
#   export MUSE_TOPO_TIMEOUT_S=600
# Largest all-reduce of the decode/medium algorithms in bytes, sets the workspace size (TopoComm default 8 MiB applies when
# unset; larger all-reduces up to 2 GiB, reduce_scatter and big all-gather shards use the large algorithms, no extra memory):
#   export MUSE_TOPO_MAX_BYTES=8388608
# Disable the fused collective + epilogue kernels of the decode layer (all_reduce_boundary, all_gather_boundary,
# all_gather_rmsnorm; bit-exact mirrors of the Triton boundary kernels, class identical, see
# docs/r2d_fused_epilogue.md); the model then runs the two steps. With the medium bf16 exchange on (below) that is NOT
# bit-identical for T = 4..8: the unfused attn-out all-reduce (64..128 KiB) takes the bf16 exchange, the fused kernel
# is always exact. For a bit-identical fused on / off A/B set MUSE_TOPO_MEDIUM_BX=0 together with MUSE_TOPO_FUSED=0
# (and in the fused-on run too):
#   export MUSE_TOPO_FUSED=0
# Sharded pooler / unpooler GEMV of the decode layer (T <= MUSE_TOPO_GEMV_MAX_ROWS, 4 by default) run by the collective kernels together with the all-gather behind them (r3b,
# docs/r3b_gemv_push.md). Default ON, with the vLLM-side offer VLLM_MUSE_SPARK_SM120_FUSED_GEMV (default 1) and the fp32 router GEMV
# VLLM_MUSE_SPARK_SM120_ROUTER_GEMV (default 1; needs the fp32 router input of the expert prefetch, otherwise the router stays on cuBLAS and
# the vLLM log says so once). Class deterministic_different against the cuBLAS GEMV / router (fixed fp32 order, deterministic, equal on every
# rank, the same bits at every batch size); the pooler GEMV is more accurate than cuBLAS at T >= 2 (equal at T = 1), the unpooler equal. Real
# weights, random 512/128 TPOT, all on: c1 -4.2 %, c4 -3.2 %, c16 / c64 flat (S1-4a, 2026-10-27). Needs MUSE_TOPO_FUSED != 0. For the
# behaviour without them set all three to 0 (the settings must be identical on every rank):
#   export MUSE_TOPO_GEMV=0
#   export VLLM_MUSE_SPARK_SM120_FUSED_GEMV=0
#   export VLLM_MUSE_SPARK_SM120_ROUTER_GEMV=0
# When the all-reduce in front of a GEMV lets the GEMV kernel start: 0 = never, 1 = at its start (delays the all-reduce by ~5 us), 2 = when its
# last communication phase begins, 3 = when it has ended (default 3). Decision run 2026-10-27 (c1 / c4 TPOT 9.214 / 14.788 ms for 3, 9.209 / 14.937
# for 2): 3 is 0.60 % better on mean(c1, c4), driven by c4 and inside the drift of the session, i.e. not robust; c1 is equal. The stage belongs to
# the launch: only the all-reduces that precede a GEMV carry it (all_reduce_boundary and the bf16 [T, 4096] all-reduce of the MoE latent, T <= MAX_ROWS),
# every other topo kernel keeps the implicit trigger at its exit:
#   export MUSE_TOPO_GEMV_TRIGGER=3
# Push mode of the GEMV kernel (0 = the gather kernel pushes, 1 = every CTA pushes (default), 2 = the last CTA pushes; +4 = weights loaded after
# the wait; valid 0, 1, 2, 4, 5, 6; 3, 7 and anything else are rejected at start-up), the largest padded decode batch the GEMV kernels serve
# (clamped to 0 .. 8, default 4: the padded batches 1, 2, 4 gain, the padded 8 of c5 .. c8 and of the K = 7 verify batch shows no gain, c8 TPOT
# 19.992 ms with 8, 19.897 with 4, 19.738 everything off; above it cuBLAS + the r2d gather) and a pinned geometry variant (0 .. 3; unset = by
# rows, same summation order):
#   export MUSE_TOPO_GEMV_PUSH=1
#   export MUSE_TOPO_GEMV_MAX_ROWS=4
#   export MUSE_TOPO_GEMV_VARIANT=0
# Bytes of the routing-aware expert L2 prefetch of the decode graphs (vLLM branch knob, default 12 MiB; a cache hint, no numeric effect; c1 TPOT
# 9.180 ms at 12 MiB, 9.202 at 20 MiB, 9.230 at 28 MiB):
#   export VLLM_MUSE_SPARK_SM120_EXPERT_PREFETCH_BYTES=12582912
# Disable the large-message algorithms (A/B switch: all-reduce > 8 MiB, reduce_scatter, all-gather shards > 1 MiB -> NCCL):
#   export MUSE_TOPO_LARGE=0
# One-time per-op/shape/stream summary at info level: 1 = group rank 0, 2 = every rank (default: debug level):
#   export MUSE_TOPO_LOG_OPS=1
# Throughput defaults (user decision 2026-10-24: rounding-level differences are acceptable as long as the final sampling
# is unaffected; GSM8K with SP + bf16 exchange 96.2 % vs NCCL 96.2 %). Set either to 0 to get the exact paths; an empty
# value does not disable them (":=" replaces an empty flag by 1, MUSE_TOPO_MEDIUM_BX is only off for an explicit 0).
# Large-message bf16 partial exchange (class deterministic_different; deterministic and rank-identical): prefill
# all-reduce 128 MiB 7.10 -> 5.84 ms, ctx90 prefill +11 % pp with SP (docs/h2_vllm_plugin.md). bf16 inputs only.
: "${MUSE_TOPO_LARGE_BF16_EXCHANGE:=1}"
# The same bf16 exchange for the medium bf16 all-reduces, i.e. the messages from MUSE_TOPO_MEDIUM_BX_MIN_BYTES
# (64 KiB) on: in decode the embedding all-reduce [T, 8192] from T = 4 (eager; padded T = 4 in the CUDA graphs), the
# MoE-out all-reduce [T, 4096] from T = 8 (padded T = 8) and the attn-out all-reduce [T, 8192] from T = 9
# (padded T = 16; T <= 8 is the exact fused kernel). Algorithm 2 with rounded island partials; same bits as the
# large algorithm, class deterministic_different; only active together with the large-message flag above,
# docs/r3c_medium_ar.md. Set to 0 for the exact fp32 exchange below 2 MiB. The attn-out all-reduce of the fused
# T <= 8 decode kernels is exact only while the fused kernels are on (see MUSE_TOPO_FUSED above). These settings
# must be identical on every rank:
#   export MUSE_TOPO_MEDIUM_BX=0
#   export MUSE_TOPO_MEDIUM_BX_MIN_BYTES=65536
# Experiment hook: JSON with bx_table / bx_min / large_min_bx overriding the tuned values (bench/make_table_medium.py writes it):
#   export MUSE_TOPO_AR_TUNING_FILE=/path/tuning.json
# NCCL graph file for the collectives that still use NCCL (non-TP groups, fallbacks): 4-channel ring with LL for small
# messages (class deterministic_different, see nccl/). Only takes effect if the file exists.
if [ -z "${NCCL_GRAPH_FILE+x}" ] && [ -n "${HOST:-}" ] && [ -f "$HOST/nccl/graph_r4.xml" ]; then
  NCCL_GRAPH_FILE=$HOST/nccl/graph_r4.xml
fi
export MUSE_TOPO_LARGE_BF16_EXCHANGE
# CTAs of the L2 weight prefetch behind the experts of each decode layer (vLLM branch knob, default 4 for the stock NCCL
# collectives). With the muse_topo collectives the layer is 160 us instead of 296 us and the 4-CTA launch (113 us) is still
# running when the pooler and router weights are due: 8 CTAs give TPOT 10.69 -> 9.80 ms at batch 1 (real weights), whereas
# on NCCL (MUSE_TOPO_ENABLE=0) 8 CTAs are slower than 4 (17.09 against 16.90 ms). Cache hint, no numeric effect; a vLLM
# tree without the knob ignores it.
if [ "$MUSE_TOPO_ENABLE" = 1 ]; then
  : "${VLLM_MUSE_SPARK_SM120_L2_PREFETCH_AFTER_EXPERTS_CTAS:=8}"
  export VLLM_MUSE_SPARK_SM120_L2_PREFETCH_AFTER_EXPERTS_CTAS
fi
if [ -n "${NCCL_GRAPH_FILE:-}" ]; then export NCCL_GRAPH_FILE; fi
