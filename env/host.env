# Host environment of the 8x RTX PRO 6000 (AS-5126GS-TNRT2) box. Sourced by scripts/run_src_topo.sh and
# scripts/runsrc_topo.sh. Every value can be overridden by exporting it before the script runs (":=" keeps a preset
# value), e.g. MUSE_TOPO_ENABLE=0 gives the NCCL-only baseline with the same launch path.

# Direct P2P across the CPU sockets: NCCL 2.29.7's graph search fails on this box and routes the 4 cross-pair ring
# hops through host SHM. Same ring/channels/protocol, bitwise identical outputs (2026-10-21). Default ON.
: "${NCCL_P2P_LEVEL:=SYS}"
# muse_topo vLLM plugin (muse_topo/vllm_plugin.py, found through muse_topo-0.1.dist-info on PYTHONPATH): TP all-reduce /
# all-gather over the topology-specialized P2P kernels, class more_accurate (single final rounding of an fp32 sum).
: "${MUSE_TOPO_ENABLE:=1}"
export NCCL_P2P_LEVEL MUSE_TOPO_ENABLE

# ---- opt-ins and knobs (all off / defaults unless uncommented) ---------------------------------------------------
# Route only some ops through the topo path (default: all_reduce,all_gather,reduce_scatter):
#   export MUSE_TOPO_OPS=all_reduce
# Spin timeout of the kernels in seconds (plugin default 600; the kernel traps when a peer is later than this):
#   export MUSE_TOPO_TIMEOUT_S=600
# Largest all-reduce of the decode/medium algorithms in bytes, sets the workspace size (TopoComm default 8 MiB applies when
# unset; larger all-reduces up to 2 GiB, reduce_scatter and big all-gather shards use the large algorithms, no extra memory):
#   export MUSE_TOPO_MAX_BYTES=8388608
# Disable the fused collective + epilogue kernels of the decode layer (all_reduce_boundary, all_gather_boundary, all_gather_rmsnorm;
# bit-exact mirrors of the Triton boundary kernels, class identical, see docs/r2d_fused_epilogue.md); the model then runs the two steps:
#   export MUSE_TOPO_FUSED=0
# Disable the large-message algorithms (A/B switch: all-reduce > 8 MiB, reduce_scatter, all-gather shards > 1 MiB -> NCCL):
#   export MUSE_TOPO_LARGE=0
# One-time per-op/shape/stream summary at info level: 1 = group rank 0, 2 = every rank (default: debug level):
#   export MUSE_TOPO_LOG_OPS=1
# Throughput defaults (user decision 2026-10-24: rounding-level differences are acceptable as long as the final sampling
# is unaffected; GSM8K with SP + bf16 exchange 96.2 % vs NCCL 96.2 %). Set either to 0 / empty to get the exact paths.
# Large-message bf16 partial exchange (class deterministic_different; deterministic and rank-identical): prefill
# all-reduce 128 MiB 7.10 -> 5.84 ms, ctx90 prefill +11 % pp with SP (docs/h2_vllm_plugin.md). bf16 inputs only.
: "${MUSE_TOPO_LARGE_BF16_EXCHANGE:=1}"
# NCCL graph file for the collectives that still use NCCL (non-TP groups, fallbacks): 4-channel ring with LL for small
# messages (class deterministic_different, see nccl/). Only takes effect if the file exists.
if [ -z "${NCCL_GRAPH_FILE+x}" ] && [ -n "${HOST:-}" ] && [ -f "$HOST/nccl/graph_r4.xml" ]; then
  NCCL_GRAPH_FILE=$HOST/nccl/graph_r4.xml
fi
export MUSE_TOPO_LARGE_BF16_EXCHANGE
# CTAs of the L2 weight prefetch behind the experts of each decode layer (vLLM branch knob, default 4 for the stock NCCL
# collectives). With the muse_topo collectives the layer is 160 us instead of 296 us and the 4-CTA launch (113 us) is still
# running when the pooler and router weights are due: 8 CTAs give TPOT 10.69 -> 9.80 ms at batch 1 (real weights), whereas
# on NCCL (MUSE_TOPO_ENABLE=0) 8 CTAs are slower than 4 (17.09 against 16.90 ms). Cache hint, no numeric effect; a vLLM
# tree without the knob ignores it.
if [ "$MUSE_TOPO_ENABLE" = 1 ]; then
  : "${VLLM_MUSE_SPARK_SM120_L2_PREFETCH_AFTER_EXPERTS_CTAS:=8}"
  export VLLM_MUSE_SPARK_SM120_L2_PREFETCH_AFTER_EXPERTS_CTAS
fi
if [ -n "${NCCL_GRAPH_FILE:-}" ]; then export NCCL_GRAPH_FILE; fi
